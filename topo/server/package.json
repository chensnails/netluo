{
  "name": "netluo",
  "version": "1.2.0",
  "private": true,
  "description": "络图 NetLuo — 网络拓扑与 Markdown 文档协作平台",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "smoke": "node src/index.js --smoke",
    "test:migrate": "node build/test-migration.mjs",
    "vendor": "node build/vendor.mjs",
    "build:sea": "npm run vendor && node build/sea.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "markdown-it": "^15.0.2",
    "vditor": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true
  }
}
