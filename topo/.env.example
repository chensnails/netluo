# 装的时候不用手改这个文件：跑仓库根目录的 install.sh 会自动生成。
# 手工部署时复制为 .env 再改。.env 已被 .gitignore 排除，永远不要提交。

# 管理员密码。只在第一次初始化（users 表为空）时生效，之后改它无效——
# 改密码请在页面「设置 → 账户」里做。
# 留空则由服务端生成随机密码，写在数据卷的 admin-password 文件里（容器内 /data/admin-password），
# 日志只打印路径不打印密码，取完建议删除该文件。
ADMIN_PASSWORD=

# 登录令牌的签名密钥。留空则生成随机值并持久化到数据卷的 token.secret，
# 重启/升级不会踢掉在线用户；跨实例迁移时把这份文件一起搬走，登录态才不会失效。
TOPO_SECRET=

# 浏览器可访问的 drawio 地址（含协议+主机+端口）。填 127.0.0.1 会导致别人打不开画布。
# 单独暴露端口时：DRAWIO_URL=http://your-host:3091
# 走仓库里 topo/nginx/netluo.conf 的单域名反代时：DRAWIO_URL=https://your-host/drawio
DRAWIO_URL=http://your-host:3091

# 宿主机映射端口（compose 的 ports 用它），install.sh --port 写的就是这个
PORT=3090

# compose 拉取/构建的镜像标签，升级时改这里并 docker compose up -d
NETLUO_VERSION=1

# 可选：填一个口令即开放「自助注册」，访问者需提交该注册码。留空/删除即关闭。
# REGISTRATION_CODE=

# 可选：部署在 nginx/caddy 等反向代理之后时设为 1（让限速和 Secure cookie 看到真实客户端 IP）；
# 代理与本机同机时用 loopback。直接暴露端口则保持注释掉。
# TRUST_PROXY=1

# 可选：结构迁移前自动 VACUUM INTO 一份快照（默认开启）。设 0 关闭。
# TOPO_BACKUP_ON_MIGRATE=1
